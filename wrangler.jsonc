
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meterpams",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
